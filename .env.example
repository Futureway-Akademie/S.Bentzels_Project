# Kopieren nach .env und ausfüllen. Die Datei .env gehört nie ins Repository.
# Zu finden im Supabase Dashboard unter Project Settings > API.
# Hier nur Project URL und den öffentlichen "anon"-Schlüssel eintragen,
# NIEMALS den "service_role"-Schlüssel.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Öffentliche Adresse der Website (für Canonical, Open Graph, Sitemap), z. B. https://beispiel.de
VITE_SITE_URL=
